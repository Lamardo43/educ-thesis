\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{check\PYGZus{}rate\PYGZus{}limit}\PYG{p}{(}\PYG{n}{filename}\PYG{p}{:} \PYG{n+nb}{str}\PYG{p}{,} \PYG{n}{limit}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n}{window\PYGZus{}size}\PYG{p}{:} \PYG{n+nb}{int} \PYG{o}{=} \PYG{l+m+mi}{1}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n+nb}{bool}\PYG{p}{:}
    \PYG{c+c1}{\PYGZsh{} Шаг 1: вычислить метку текущего окна}
    \PYG{n}{window} \PYG{o}{=} \PYG{n}{floor}\PYG{p}{(}\PYG{n}{current\PYGZus{}unix\PYGZus{}timestamp}\PYG{p}{()} \PYG{o}{/} \PYG{n}{window\PYGZus{}size}\PYG{p}{)}
    \PYG{n}{key}    \PYG{o}{=} \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}rate:}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{filename}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{:}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{window}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}

    \PYG{c+c1}{\PYGZsh{} Шаг 2: атомарный инкремент счётчика}
    \PYG{n}{count} \PYG{o}{=} \PYG{n}{INCR}\PYG{p}{(}\PYG{n}{key}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Шаг 3: установить TTL при создании нового окна}
    \PYG{k}{if} \PYG{n}{count} \PYG{o}{==} \PYG{l+m+mi}{1}\PYG{p}{:}
        \PYG{n}{EXPIRE}\PYG{p}{(}\PYG{n}{key}\PYG{p}{,} \PYG{n}{window\PYGZus{}size}   \PYG{l+m+mi}{2}\PYG{p}{)}  \PYG{c+c1}{\PYGZsh{} TTL = 2 окна (запас на сдвиг времени)}

    \PYG{c+c1}{\PYGZsh{} Шаг 4: проверить лимит}
    \PYG{k}{if} \PYG{n}{count} \PYG{o}{\PYGZgt{}} \PYG{n}{limit}\PYG{p}{:}
        \PYG{k}{return} \PYG{k+kc}{False}  \PYG{c+c1}{\PYGZsh{} запрос отклонён \PYGZhy{}\PYGZgt{} HTTP 429}
    \PYG{k}{return} \PYG{k+kc}{True}       \PYG{c+c1}{\PYGZsh{} запрос разрешён}
\end{MintedVerbatim}
