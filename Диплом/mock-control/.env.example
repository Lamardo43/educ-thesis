# Redis — хост и порт. redis-server будет запущен автоматически
# если по этому адресу он ещё не доступен.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Директория для хранения данных Redis (AOF + RDB) и Fernet-ключа.
# Создаётся автоматически при первом запуске.
REDIS_DATA_DIR=./data/redis

# Путь к файлу ключа шифрования паролей SSH.
# Генерируется автоматически при первом запуске.
FERNET_KEY_PATH=./data/fernet.key

# Временная директория для загружаемых артефактов
UPLOAD_TEMP_DIR=./data/uploads

APP_HOST=0.0.0.0
APP_PORT=8000

# Опционально: если хотите использовать внешний Redis,
# укажите полный URL — тогда встроенный запуск пропускается.
# REDIS_URL=redis://my-external-redis:6379/0
