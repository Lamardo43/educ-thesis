# ============================================================
# MockControl — Configuration
# ============================================================
# Скопируйте этот файл: cp .env.example .env
# Все переменные имеют префикс MC_ (MockControl)

# --- Redis ---
MC_REDIS_URL=redis://localhost:6379/0

# --- Безопасность ---
# Путь к файлу с ключом шифрования Fernet (AES-128).
# При первом запуске ключ генерируется автоматически.
# Файл создаётся с правами 600 (чтение/запись только владельцу).
MC_FERNET_KEY_PATH=fernet.key

# --- Временный каталог ---
# Каталог для временного хранения загруженных артефактов.
# Файлы удаляются сразу после копирования на целевой хост.
MC_TMP_UPLOAD_DIR=/tmp/mockcontrol_uploads

# --- Сервер ---
MC_HOST=0.0.0.0
MC_PORT=8000

# --- Значения по умолчанию для глобальных настроек ---
# (используются при первом запуске, затем управляются через API/UI)
MC_DEFAULT_RATE_LIMIT_WINDOW=1
MC_DEFAULT_HOST_CHECK_INTERVAL=30
MC_DEFAULT_PROXY_TIMEOUT=10
MC_DEFAULT_LOG_RETENTION_LINES=1000
