\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{class}\PYG{+w}{ }\PYG{n+nc}{RateLimiter}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Ограничение частоты запросов на заглушку в фиксированных временных окнах.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf+fm}{\PYGZus{}\PYGZus{}init\PYGZus{}\PYGZus{}}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{redis}\PYG{p}{:} \PYG{n}{Redis}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{k+kc}{None}\PYG{p}{:}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{\PYGZus{}redis} \PYG{o}{=} \PYG{n}{redis}

    \PYG{k}{async} \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{check}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{filename}\PYG{p}{:} \PYG{n+nb}{str}\PYG{p}{,} \PYG{n}{limit}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
                    \PYG{n}{window\PYGZus{}size}\PYG{p}{:} \PYG{n+nb}{int} \PYG{o}{=} \PYG{l+m+mi}{1}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n+nb}{bool}\PYG{p}{:}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Инкрементирует счётчик текущего окна.}
\PYG{l+s+sd}{        Возвращает True, если запрос в пределах лимита.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n}{window} \PYG{o}{=} \PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{time}\PYG{o}{.}\PYG{n}{time}\PYG{p}{())} \PYG{o}{//} \PYG{n}{window\PYGZus{}size}
        \PYG{n}{key}    \PYG{o}{=} \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}rate:}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{filename}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{:}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{window}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}

        \PYG{c+c1}{\PYGZsh{} Атомарный инкремент: Redis гарантирует неделимость операции}
        \PYG{n}{count} \PYG{o}{=} \PYG{k}{await} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{\PYGZus{}redis}\PYG{o}{.}\PYG{n}{incr}\PYG{p}{(}\PYG{n}{key}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} TTL устанавливается только при создании нового счётчика (count == 1)}
        \PYG{k}{if} \PYG{n}{count} \PYG{o}{==} \PYG{l+m+mi}{1}\PYG{p}{:}
            \PYG{k}{await} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{\PYGZus{}redis}\PYG{o}{.}\PYG{n}{expire}\PYG{p}{(}\PYG{n}{key}\PYG{p}{,} \PYG{n}{window\PYGZus{}size} \PYG{o}{*} \PYG{l+m+mi}{2}\PYG{p}{)}

        \PYG{k}{return} \PYG{n}{count} \PYG{o}{\PYGZlt{}=} \PYG{n}{limit}   \PYG{c+c1}{\PYGZsh{} True \PYGZhy{}\PYGZgt{} разрешить, False \PYGZhy{}\PYGZgt{} HTTP 429}
