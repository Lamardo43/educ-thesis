# Скопируйте в `.env` и при необходимости измените значения.
# Имена переменных соответствуют `config.py` / разделу «Конфигурация» в ТЗ.

REDIS_URL=redis://localhost:6379/0
FERNET_KEY_PATH=/etc/mockcontrol/fernet.key
TEMP_UPLOAD_DIR=/tmp/mockcontrol

DEFAULT_RATE_LIMIT_WINDOW=1
DEFAULT_HOST_CHECK_INTERVAL=30
DEFAULT_PROXY_TIMEOUT=10
DEFAULT_LOG_RETENTION_LINES=1000
